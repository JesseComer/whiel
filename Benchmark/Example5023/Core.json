    {
      "level": 0,
      "source": "((of_z2 = ∅[0]) ∨ ((of_z0 = ⊤) ∨ (op_zUnderI = π[0] (σ[#1 = #2] ((op_zMove × op_zNotOver))))))"
    },
    {
      "level": 0,
      "source": "((of_z2 = ⊤) ∨ ((¬((op_zUnder = op_zPrev))) ∨ (op_zOver = π[0] (σ[#1 = #2] ((op_zMove × (op_zNodes ∖ op_zPrev)))))))"
