    {
      "level": 0,
      "source": "((of_z2 = ⊤) ∨ ((¬((op_zUnder = op_zPrev))) ∨ (op_zUnder = π[0] (σ[#1 = #2] ((op_zMove × (op_zNodes ∖ op_zOver)))))))"
    },
    {
      "level": 1,
      "source": "((of_z2 = ∅[0]) ∨ ((of_z0 = ⊤) ∨ ((op_zNodes ∖ op_zOver) ⊆ yp_zLose)))"
