-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Certified delegation closure exceeds audit-bound authorization.

  Kind: containment (goal C1_subset_C2); C1 output GrantA, C2 output AllowB.

  Authorization delegation is staged through certification and review. C1 can continue a reviewed handoff while an existing grant remains active, whereas C2 insists on a matching audit tuple for each promotion, so the first deep unaudited review separates them.

  A two-program containment under tuple-generating dependencies, generated by GPT (raw_invalid_gpt
  batch) in the legacy raw_new pipeline (retired corpus case Example3009); the dependencies are the
  precondition, translated to relational algebra by the certified translation of the retired corpus
  DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The dependencies, in the legacy
  relational-calculus notation:
    ∀x1. Root(x1) → ∃y1. (Delegate(x1, y1) ∧ Audit(x1, y1, x1))
    ∀x1. ∀y1. ∀z1. Audit(x1, y1, z1) → (Certified(x1, y1) ∧ Trust(z1))
    ∀x1. ∀y1. (Delegate(x1, y1) ∧ Certified(x1, y1)) → Review(x1, y1)
    ∀x1. ∀y1. ∀z1. (Review(x1, y1) ∧ Audit(x1, y1, z1)) → Delegate(z1, y1)

  Program C1 (output GrantA):
    `GrantA(x1) :- Root(x1)`
    `PendingA(y1) :- GrantA(x1), Delegate(x1, y1)`
    `CheckedA(y1) :- PendingA(y1), Certified(x1, y1), Trust(x1)`
    `GrantA(y1) :- CheckedA(y1)`
    `PendingA(y1) :- CheckedA(x1), GrantA(z1), Review(x1, y1)`

  Program C2 (output AllowB):
    `AllowB(x1) :- Root(x1)`
    `QueueB(y1) :- AllowB(x1), Delegate(x1, y1)`
    `VettedB(y1) :- QueueB(y1), Certified(x1, y1), Trust(x1)`
    `AllowB(y1) :- VettedB(y1), Audit(x1, y1, z1), AllowB(z1)`
    `QueueB(y1) :- VettedB(x1), Review(x1, y1)`

  The command is the two programs compiled by the naive compiler and run one after the other
  (snapshots `X_aux`); the legacy encoding ran them as one concurrent-product loop, whose steps are
  the same, so the outputs are the same least fixpoints (product_outputs_are_LFPs in the retired
  corpus DatalogSource.lean; checked on instances here). Precondition: the dependencies;
  postcondition `(GrantA ⊆ AllowB)`.

  Expected verdict: invalid. Witness: Root = [[0]]; Delegate = [[0, 1]]; Certified = [[0, 1], [1, 2], [2, 3]]; Audit = [[0, 1, 0]]; Trust = [[0], [1], [2]]; Review = [[0, 1], [1, 2], [2, 3]].
  The kernel counterexample is in Certificate/Invalid.lean (the legacy
  witness, restated over the compiled sequence).

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example3009

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Root, Trust, GrantA, PendingA, CheckedA, AllowB, QueueB, VettedB, GrantA_aux, PendingA_aux, CheckedA_aux, AllowB_aux, QueueB_aux, VettedB_aux} (arity: 1),
    {Delegate, Certified, Review} (arity: 2),
    {Audit} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Root ⊆ π[0] (σ[((#0 = #2 ∧ #1 = #3) ∧ #0 = #4)] ((Delegate × Audit)))) ∧ ((Audit ⊆ (Certified × Trust)) ∧ ((π[0,1] (σ[(#0 = #2 ∧ #1 = #3)] ((Delegate × Certified))) ⊆ Review) ∧ (π[1,4] (σ[(#0 = #2 ∧ #1 = #3)] ((Review × Audit))) ⊆ π[1,0] (Delegate)))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      GrantA_aux := ∅[1];
      PendingA_aux := ∅[1];
      CheckedA_aux := ∅[1];
      GrantA := (Root ∪ CheckedA_aux);
      PendingA := (π[2] (σ[#0 = #1] ((GrantA_aux × Delegate))) ∪ π[3] (σ[#0 = #2] ((CheckedA_aux × (GrantA_aux × Review)))));
      CheckedA := π[0] (σ[(#0 = #2 ∧ #1 = #3)] ((PendingA_aux × (Certified × Trust))));
      WHILE (¬(((GrantA = GrantA_aux) ∧ ((PendingA = PendingA_aux) ∧ (CheckedA = CheckedA_aux))))) DO
        GrantA_aux := GrantA;
        PendingA_aux := PendingA;
        CheckedA_aux := CheckedA;
        GrantA := (GrantA ∪ (Root ∪ CheckedA_aux));
        PendingA := (PendingA ∪ (π[2] (σ[#0 = #1] ((GrantA_aux × Delegate))) ∪ π[3] (σ[#0 = #2] ((CheckedA_aux × (GrantA_aux × Review))))));
        CheckedA := (CheckedA ∪ π[0] (σ[(#0 = #2 ∧ #1 = #3)] ((PendingA_aux × (Certified × Trust)))))
      END;
      AllowB_aux := ∅[1];
      QueueB_aux := ∅[1];
      VettedB_aux := ∅[1];
      AllowB := (Root ∪ π[0] (σ[(#0 = #2 ∧ #3 = #4)] ((VettedB_aux × (Audit × AllowB_aux)))));
      QueueB := (π[2] (σ[#0 = #1] ((AllowB_aux × Delegate))) ∪ π[2] (σ[#0 = #1] ((VettedB_aux × Review))));
      VettedB := π[0] (σ[(#0 = #2 ∧ #1 = #3)] ((QueueB_aux × (Certified × Trust))));
      WHILE (¬(((AllowB = AllowB_aux) ∧ ((QueueB = QueueB_aux) ∧ (VettedB = VettedB_aux))))) DO
        AllowB_aux := AllowB;
        QueueB_aux := QueueB;
        VettedB_aux := VettedB;
        AllowB := (AllowB ∪ (Root ∪ π[0] (σ[(#0 = #2 ∧ #3 = #4)] ((VettedB_aux × (Audit × AllowB_aux))))));
        QueueB := (QueueB ∪ (π[2] (σ[#0 = #1] ((AllowB_aux × Delegate))) ∪ π[2] (σ[#0 = #1] ((VettedB_aux × Review)))));
        VettedB := (VettedB ∪ π[0] (σ[(#0 = #2 ∧ #1 = #3)] ((QueueB_aux × (Certified × Trust)))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (GrantA ⊆ AllowB)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example3009
end Benchmark
end Whiel
