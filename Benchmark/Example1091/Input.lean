-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Delegation reachability bounded by a transitively closed policy view.

  Kind: containment (goal C1_subset_C2); C1 output P, C2 output T.

  Authorization reachability under a schema mapping: C1 derives grantable accesses via mutually recursive delegation and role-composition bounded by a transitively closed policy relation, while C2 recomputes reachable grants over a base relation the mapping forces to subsume the policy.

  A two-program containment under tuple-generating dependencies,
  generated by Claude Opus in the legacy raw_new pipeline (retired
  corpus case Example1091); the dependencies are the precondition,
  translated to relational algebra by the certified translation of the
  retired corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. ∀z1. (C(x1, y1) ∧ C(y1, z1)) → C(x1, z1)
    ∀x1. ∀y1. Mid(x1, y1) → C(x1, y1)
    ∀x1. ∀y1. Link(x1, y1) → ∃z1. (Mid(x1, z1) ∧ Mid(z1, y1))
    ∀x1. ∀y1. ∀z1. Tri(x1, y1, z1) → C(x1, z1)
    ∀x1. ∀y1. C(x1, y1) → BaseTwo(x1, y1)

  Program C1 (output P):
    `P(x1, y1) :- Link(x1, y1)`
    `P(x1, y1) :- Mid(x1, y1)`
    `P(x1, z1) :- P(x1, y1), Q(y1, z1)`
    `P(x1, x2) :- P(x1, y1), Mid(y1, z1), P(z1, x2)`
    `Q(x1, y1) :- Tri(x1, z1, y1)`
    `Q(x1, z1) :- Q(x1, y1), P(y1, z1)`

  Program C2 (output T):
    `T(x1, y1) :- BaseTwo(x1, y1)`
    `G(x1, y1) :- Jump(x1, y1)`
    `G(x1, z1) :- G(x1, y1), Jump(y1, z1)`
    `T(x1, z1) :- T(x1, y1), G(y1, z1)`
    `T(x1, z1) :- T(x1, y1), T(y1, z1)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(P ⊆ T)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1091

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {C, Mid, Link, BaseTwo, Jump, P, Q, T, G, P_aux, Q_aux, T_aux, G_aux} (arity: 2),
    {Tri} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((π[0,3] (σ[#1 = #2] ((C × C))) ⊆ C) ∧ ((Mid ⊆ C) ∧ ((Link ⊆ π[0,3] (σ[#1 = #2] ((Mid × Mid)))) ∧ ((π[0,2] (Tri) ⊆ C) ∧ (C ⊆ BaseTwo)))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      P_aux := ∅[2];
      Q_aux := ∅[2];
      P := (Link ∪ (Mid ∪ (π[0,3] (σ[#1 = #2] ((P_aux × Q_aux))) ∪ π[0,5] (σ[(#1 = #2 ∧ #3 = #4)] ((P_aux × (Mid × P_aux)))))));
      Q := (π[0,2] (Tri) ∪ π[0,3] (σ[#1 = #2] ((Q_aux × P_aux))));
      WHILE (¬(((P = P_aux) ∧ (Q = Q_aux)))) DO
        P_aux := P;
        Q_aux := Q;
        P := (P ∪ (Link ∪ (Mid ∪ (π[0,3] (σ[#1 = #2] ((P_aux × Q_aux))) ∪ π[0,5] (σ[(#1 = #2 ∧ #3 = #4)] ((P_aux × (Mid × P_aux))))))));
        Q := (Q ∪ (π[0,2] (Tri) ∪ π[0,3] (σ[#1 = #2] ((Q_aux × P_aux)))))
      END;
      T_aux := ∅[2];
      G_aux := ∅[2];
      T := (BaseTwo ∪ (π[0,3] (σ[#1 = #2] ((T_aux × G_aux))) ∪ π[0,3] (σ[#1 = #2] ((T_aux × T_aux)))));
      G := (Jump ∪ π[0,3] (σ[#1 = #2] ((G_aux × Jump))));
      WHILE (¬(((T = T_aux) ∧ (G = G_aux)))) DO
        T_aux := T;
        G_aux := G;
        T := (T ∪ (BaseTwo ∪ (π[0,3] (σ[#1 = #2] ((T_aux × G_aux))) ∪ π[0,3] (σ[#1 = #2] ((T_aux × T_aux))))));
        G := (G ∪ (Jump ∪ π[0,3] (σ[#1 = #2] ((G_aux × Jump)))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (P ⊆ T)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1091
end Benchmark
end Whiel
