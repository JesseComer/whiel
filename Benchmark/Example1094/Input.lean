-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Routing table contained in an administratively closed distance view.

  Kind: containment (goal C1_subset_C2); C1 output Route, C2 output Dist.

  Network routing: C1 builds a route table by composing peer and adjacency hops plus ternary relay legs, while C2 recomputes distances over an administrative relation the policy forces to be transitively closed and to subsume every route, so C1's table is contained in it.

  A two-program containment under tuple-generating dependencies,
  generated by Claude Opus in the legacy raw_new pipeline (retired
  corpus case Example1094); the dependencies are the precondition,
  translated to relational algebra by the certified translation of the
  retired corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. Peer(x1, y1) → Admin(x1, y1)
    ∀x1. ∀y1. Adj(x1, y1) → Admin(x1, y1)
    ∀x1. ∀y1. ∀z1. (Admin(x1, y1) ∧ Admin(y1, z1)) → Admin(x1, z1)
    ∀x1. ∀y1. ∀z1. Relay(x1, y1, z1) → Admin(x1, z1)
    ∀x1. ∀y1. Peer(x1, y1) → ∃z1. Relay(x1, z1, y1)

  Program C1 (output Route):
    `Route(x1, y1) :- Peer(x1, y1)`
    `Hop(x1, y1) :- Adj(x1, y1)`
    `Hop(x1, z1) :- Route(x1, y1), Hop(y1, z1)`
    `Route(x1, z1) :- Route(x1, y1), Hop(y1, z1)`
    `Route(x1, z1) :- Route(x1, y1), Relay(y1, x2, z1)`
    `Route(x1, z1) :- Route(x1, y1), Route(y1, z1)`

  Program C2 (output Dist):
    `Dist(x1, y1) :- Admin(x1, y1)`
    `Span(x1, y1) :- Adj(x1, y1)`
    `Span(x1, z1) :- Span(x1, y1), Span(y1, z1)`
    `Dist(x1, z1) :- Dist(x1, y1), Span(y1, z1)`
    `Dist(x1, z1) :- Dist(x1, y1), Dist(y1, z1)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(Route ⊆ Dist)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1094

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Peer, Adj, Admin, Route, Hop, Dist, Span, Route_aux, Hop_aux, Dist_aux, Span_aux} (arity: 2),
    {Relay} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Peer ⊆ Admin) ∧ ((Adj ⊆ Admin) ∧ ((π[0,3] (σ[#1 = #2] ((Admin × Admin))) ⊆ Admin) ∧ ((π[0,2] (Relay) ⊆ Admin) ∧ (Peer ⊆ π[0,2] (Relay))))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      Route_aux := ∅[2];
      Hop_aux := ∅[2];
      Route := (Peer ∪ (π[0,3] (σ[#1 = #2] ((Route_aux × Hop_aux))) ∪ (π[0,4] (σ[#1 = #2] ((Route_aux × Relay))) ∪ π[0,3] (σ[#1 = #2] ((Route_aux × Route_aux))))));
      Hop := (Adj ∪ π[0,3] (σ[#1 = #2] ((Route_aux × Hop_aux))));
      WHILE (¬(((Route = Route_aux) ∧ (Hop = Hop_aux)))) DO
        Route_aux := Route;
        Hop_aux := Hop;
        Route := (Route ∪ (Peer ∪ (π[0,3] (σ[#1 = #2] ((Route_aux × Hop_aux))) ∪ (π[0,4] (σ[#1 = #2] ((Route_aux × Relay))) ∪ π[0,3] (σ[#1 = #2] ((Route_aux × Route_aux)))))));
        Hop := (Hop ∪ (Adj ∪ π[0,3] (σ[#1 = #2] ((Route_aux × Hop_aux)))))
      END;
      Dist_aux := ∅[2];
      Span_aux := ∅[2];
      Dist := (Admin ∪ (π[0,3] (σ[#1 = #2] ((Dist_aux × Span_aux))) ∪ π[0,3] (σ[#1 = #2] ((Dist_aux × Dist_aux)))));
      Span := (Adj ∪ π[0,3] (σ[#1 = #2] ((Span_aux × Span_aux))));
      WHILE (¬(((Dist = Dist_aux) ∧ (Span = Span_aux)))) DO
        Dist_aux := Dist;
        Span_aux := Span;
        Dist := (Dist ∪ (Admin ∪ (π[0,3] (σ[#1 = #2] ((Dist_aux × Span_aux))) ∪ π[0,3] (σ[#1 = #2] ((Dist_aux × Dist_aux))))));
        Span := (Span ∪ (Adj ∪ π[0,3] (σ[#1 = #2] ((Span_aux × Span_aux)))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (Route ⊆ Dist)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1094
end Benchmark
end Whiel
