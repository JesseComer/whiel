-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Audited delegation alternation loses an uncertified reviewed hop.

  Kind: containment (goal C1_subset_C2); C1 output AccessOne, C2 output AccessTwo.

  An authorization engine alternates certified delegations with reviewer-backed delegations. The second implementation insists that a reviewed transition also be certified, so it misses a deeply authorized principal while agreeing on the audited base cases.

  A two-program containment under tuple-generating dependencies, generated by GPT (raw_invalid_gpt
  batch) in the legacy raw_new pipeline (retired corpus case Example3001); the dependencies are the
  precondition, translated to relational algebra by the certified translation of the retired corpus
  DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The dependencies, in the legacy
  relational-calculus notation:
    ∀x1. ∀y1. Certified(x1, y1) → Delegates(x1, y1)
    ∀x1. ∀y1. ∀z1. Review(x1, y1, z1) → Delegates(x1, y1)
    ∀x1. ∀y1. ∀z1. Review(x1, y1, z1) → Reviewer(z1)
    ∀x1. ∀y1. Certified(x1, y1) → ∃z1. (Review(x1, y1, z1) ∧ Reviewer(z1))
    ∀x1. ∀y1. ∀z1. ∀x2. (Certified(x1, y1) ∧ Review(y1, z1, x2)) → Delegates(x1, z1)

  Program C1 (output AccessOne):
    `AccessOne(x1) :- Root(x1)`
    `CertStateOne(y1) :- AccessOne(x1), Certified(x1, y1)`
    `ReviewStateOne(y1) :- AccessOne(x1), Review(x1, y1, z1), Reviewer(z1)`
    `AccessOne(y1) :- CertStateOne(x1), Review(x1, y1, z1), Reviewer(z1)`
    `AccessOne(y1) :- ReviewStateOne(x1), Certified(x1, y1)`
    `AccessOne(y1) :- CertStateOne(y1), ReviewStateOne(y1), Delegates(x1, y1)`

  Program C2 (output AccessTwo):
    `AccessTwo(x1) :- Root(x1)`
    `CertStateTwo(y1) :- AccessTwo(x1), Certified(x1, y1)`
    `ReviewStateTwo(y1) :- AccessTwo(x1), Review(x1, y1, z1), Reviewer(z1)`
    `JointStateTwo(y1) :- CertStateTwo(x1), Review(x1, y1, z1), Reviewer(z1), Certified(x1, y1)`
    `AccessTwo(y1) :- JointStateTwo(y1), Delegates(x1, y1)`
    `AccessTwo(y1) :- CertStateTwo(y1), ReviewStateTwo(y1), Delegates(x1, y1)`

  The command is the two programs compiled by the naive compiler and run one after the other
  (snapshots `X_aux`); the legacy encoding ran them as one concurrent-product loop, whose steps are
  the same, so the outputs are the same least fixpoints (product_outputs_are_LFPs in the retired
  corpus DatalogSource.lean; checked on instances here). Precondition: the dependencies;
  postcondition `(AccessOne ⊆ AccessTwo)`.

  Expected verdict: invalid. Witness: Root = [[0]]; Certified = [[0, 1], [1, 4]]; Review = [[0, 1, 5], [1, 2, 5], [1, 4, 5]]; Reviewer = [[5]]; Delegates = [[0, 1], [0, 2], [0, 4], [1, 2], [1, 4]].
  The kernel counterexample is in Certificate/Invalid.lean (the legacy
  witness, restated over the compiled sequence).

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example3001

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Root, Reviewer, AccessOne, CertStateOne, ReviewStateOne, AccessTwo, CertStateTwo, ReviewStateTwo, JointStateTwo, AccessOne_aux, CertStateOne_aux, ReviewStateOne_aux, AccessTwo_aux, CertStateTwo_aux, ReviewStateTwo_aux, JointStateTwo_aux} (arity: 1),
    {Certified, Delegates} (arity: 2),
    {Review} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Certified ⊆ Delegates) ∧ ((π[0,1] (Review) ⊆ Delegates) ∧ ((π[2] (Review) ⊆ Reviewer) ∧ ((Certified ⊆ π[0,1] (σ[#2 = #3] ((Review × Reviewer)))) ∧ (π[0,3] (σ[#1 = #2] ((Certified × Review))) ⊆ Delegates)))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      AccessOne_aux := ∅[1];
      CertStateOne_aux := ∅[1];
      ReviewStateOne_aux := ∅[1];
      AccessOne := (Root ∪ (π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((CertStateOne_aux × (Review × Reviewer)))) ∪ (π[2] (σ[#0 = #1] ((ReviewStateOne_aux × Certified))) ∪ π[0] (σ[(#0 = #1 ∧ #0 = #3)] ((CertStateOne_aux × (ReviewStateOne_aux × Delegates)))))));
      CertStateOne := π[2] (σ[#0 = #1] ((AccessOne_aux × Certified)));
      ReviewStateOne := π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((AccessOne_aux × (Review × Reviewer))));
      WHILE (¬(((AccessOne = AccessOne_aux) ∧ ((CertStateOne = CertStateOne_aux) ∧ (ReviewStateOne = ReviewStateOne_aux))))) DO
        AccessOne_aux := AccessOne;
        CertStateOne_aux := CertStateOne;
        ReviewStateOne_aux := ReviewStateOne;
        AccessOne := (AccessOne ∪ (Root ∪ (π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((CertStateOne_aux × (Review × Reviewer)))) ∪ (π[2] (σ[#0 = #1] ((ReviewStateOne_aux × Certified))) ∪ π[0] (σ[(#0 = #1 ∧ #0 = #3)] ((CertStateOne_aux × (ReviewStateOne_aux × Delegates))))))));
        CertStateOne := (CertStateOne ∪ π[2] (σ[#0 = #1] ((AccessOne_aux × Certified))));
        ReviewStateOne := (ReviewStateOne ∪ π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((AccessOne_aux × (Review × Reviewer)))))
      END;
      AccessTwo_aux := ∅[1];
      CertStateTwo_aux := ∅[1];
      ReviewStateTwo_aux := ∅[1];
      JointStateTwo_aux := ∅[1];
      AccessTwo := (Root ∪ (π[0] (σ[#0 = #2] ((JointStateTwo_aux × Delegates))) ∪ π[0] (σ[(#0 = #1 ∧ #0 = #3)] ((CertStateTwo_aux × (ReviewStateTwo_aux × Delegates))))));
      CertStateTwo := π[2] (σ[#0 = #1] ((AccessTwo_aux × Certified)));
      ReviewStateTwo := π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((AccessTwo_aux × (Review × Reviewer))));
      JointStateTwo := π[2] (σ[(((#0 = #1 ∧ #3 = #4) ∧ #0 = #5) ∧ #2 = #6)] ((CertStateTwo_aux × (Review × (Reviewer × Certified)))));
      WHILE (¬(((AccessTwo = AccessTwo_aux) ∧ ((CertStateTwo = CertStateTwo_aux) ∧ ((ReviewStateTwo = ReviewStateTwo_aux) ∧ (JointStateTwo = JointStateTwo_aux)))))) DO
        AccessTwo_aux := AccessTwo;
        CertStateTwo_aux := CertStateTwo;
        ReviewStateTwo_aux := ReviewStateTwo;
        JointStateTwo_aux := JointStateTwo;
        AccessTwo := (AccessTwo ∪ (Root ∪ (π[0] (σ[#0 = #2] ((JointStateTwo_aux × Delegates))) ∪ π[0] (σ[(#0 = #1 ∧ #0 = #3)] ((CertStateTwo_aux × (ReviewStateTwo_aux × Delegates)))))));
        CertStateTwo := (CertStateTwo ∪ π[2] (σ[#0 = #1] ((AccessTwo_aux × Certified))));
        ReviewStateTwo := (ReviewStateTwo ∪ π[2] (σ[(#0 = #1 ∧ #3 = #4)] ((AccessTwo_aux × (Review × Reviewer)))));
        JointStateTwo := (JointStateTwo ∪ π[2] (σ[(((#0 = #1 ∧ #3 = #4) ∧ #0 = #5) ∧ #2 = #6)] ((CertStateTwo_aux × (Review × (Reviewer × Certified))))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (AccessOne ⊆ AccessTwo)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example3001
end Benchmark
end Whiel
