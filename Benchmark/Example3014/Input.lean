-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Auditor trust diverges from resource trust under recursive elevation.

  Kind: containment (goal C1_subset_C2); C1 output AccessA, C2 output AccessB.

  Recursive policy elevation alternates grants, overrides, and proof checks. C1 trusts the proof's auditor coordinate, whereas C2 tests the resource coordinate, agreeing on the first trusted endpoint but rejecting the next audited elevation.

  A two-program containment under tuple-generating dependencies, generated by GPT (raw_invalid_gpt
  batch) in the legacy raw_new pipeline (retired corpus case Example3014); the dependencies are the
  precondition, translated to relational algebra by the certified translation of the retired corpus
  DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The dependencies, in the legacy
  relational-calculus notation:
    ∀x1. ∀y1. Request(x1, y1) → ∃z1. (Proof(x1, y1, z1) ∧ Trusted(z1))
    ∀x1. ∀y1. ∀z1. Proof(x1, y1, z1) → Permit(x1, y1)
    ∀x1. ∀y1. (Grant(x1, y1) ∧ Scope(y1)) → Permit(x1, y1)
    ∀x1. ∀y1. ∀z1. ∀x2. (Override(x1, y1) ∧ Proof(z1, y1, x2)) → Scope(x1)
    ∀x1. ∀y1. ∀z1. (Permit(x1, y1) ∧ Grant(y1, z1)) → Scope(z1)

  Program C1 (output AccessA):
    `AccessA(x1, y1) :- Request(x1, y1), Permit(x1, y1)`
    `ElevatedA(x1, z1) :- AccessA(x1, y1), Grant(y1, z1), Scope(z1)`
    `CheckedA(x1, z1) :- ElevatedA(x1, y1), Override(y1, z1), Proof(x1, z1, x2), Trusted(x2)`
    `AccessA(x1, z1) :- CheckedA(x1, z1)`
    `ElevatedA(x1, z1) :- AccessA(x1, y1), AccessA(x1, x2), Proof(y1, z1, x2)`

  Program C2 (output AccessB):
    `AccessB(x1, y1) :- Request(x1, y1), Permit(x1, y1)`
    `ElevatedB(x1, z1) :- AccessB(x1, y1), Grant(y1, z1), Scope(z1)`
    `AuditB(x1, z1, x2) :- ElevatedB(x1, y1), Override(y1, z1), Proof(x1, z1, x2)`
    `AccessB(x1, z1) :- AuditB(x1, z1, x2), Trusted(z1)`
    `ElevatedB(x1, z1) :- AccessB(x1, y1), AccessB(x1, x2), Proof(y1, z1, x2)`

  The command is the two programs compiled by the naive compiler and run one after the other
  (snapshots `X_aux`); the legacy encoding ran them as one concurrent-product loop, whose steps are
  the same, so the outputs are the same least fixpoints (product_outputs_are_LFPs in the retired
  corpus DatalogSource.lean; checked on instances here). Precondition: the dependencies;
  postcondition `(AccessA ⊆ AccessB)`.

  Expected verdict: invalid. Witness: Request = [[0, 0]]; Permit = [[0, 0], [0, 1], [0, 2], [0, 4], [2, 3]]; Grant = [[2, 3]]; Override = [[1, 2], [3, 4]]; Scope = [[1], [3]]; Proof = [[0, 0, 0], [0, 1, 0], [0, 2, 2], [0, 4, 1]]; Trusted = [[0], [1], [2]].
  The kernel counterexample is in Certificate/Invalid.lean (the legacy
  witness, restated over the compiled sequence).

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example3014

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Scope, Trusted} (arity: 1),
    {Request, Permit, Grant, Override, AccessA, ElevatedA, CheckedA, AccessB, ElevatedB, AccessA_aux, ElevatedA_aux, CheckedA_aux, AccessB_aux, ElevatedB_aux} (arity: 2),
    {Proof, AuditB, AuditB_aux} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Request ⊆ π[0,1] (σ[#2 = #3] ((Proof × Trusted)))) ∧ ((π[0,1] (Proof) ⊆ Permit) ∧ ((π[0,1] (σ[#1 = #2] ((Grant × Scope))) ⊆ Permit) ∧ ((π[0] (σ[#1 = #3] ((Override × Proof))) ⊆ Scope) ∧ (π[3] (σ[#1 = #2] ((Permit × Grant))) ⊆ Scope)))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      AccessA_aux := ∅[2];
      ElevatedA_aux := ∅[2];
      CheckedA_aux := ∅[2];
      AccessA := (π[0,1] (σ[(#0 = #2 ∧ #1 = #3)] ((Request × Permit))) ∪ CheckedA_aux);
      ElevatedA := (π[0,3] (σ[(#1 = #2 ∧ #3 = #4)] ((AccessA_aux × (Grant × Scope)))) ∪ π[0,5] (σ[((#0 = #2 ∧ #1 = #4) ∧ #3 = #6)] ((AccessA_aux × (AccessA_aux × Proof)))));
      CheckedA := π[0,3] (σ[(((#1 = #2 ∧ #0 = #4) ∧ #3 = #5) ∧ #6 = #7)] ((ElevatedA_aux × (Override × (Proof × Trusted)))));
      WHILE (¬(((AccessA = AccessA_aux) ∧ ((ElevatedA = ElevatedA_aux) ∧ (CheckedA = CheckedA_aux))))) DO
        AccessA_aux := AccessA;
        ElevatedA_aux := ElevatedA;
        CheckedA_aux := CheckedA;
        AccessA := (AccessA ∪ (π[0,1] (σ[(#0 = #2 ∧ #1 = #3)] ((Request × Permit))) ∪ CheckedA_aux));
        ElevatedA := (ElevatedA ∪ (π[0,3] (σ[(#1 = #2 ∧ #3 = #4)] ((AccessA_aux × (Grant × Scope)))) ∪ π[0,5] (σ[((#0 = #2 ∧ #1 = #4) ∧ #3 = #6)] ((AccessA_aux × (AccessA_aux × Proof))))));
        CheckedA := (CheckedA ∪ π[0,3] (σ[(((#1 = #2 ∧ #0 = #4) ∧ #3 = #5) ∧ #6 = #7)] ((ElevatedA_aux × (Override × (Proof × Trusted))))))
      END;
      AccessB_aux := ∅[2];
      ElevatedB_aux := ∅[2];
      AuditB_aux := ∅[3];
      AccessB := (π[0,1] (σ[(#0 = #2 ∧ #1 = #3)] ((Request × Permit))) ∪ π[0,1] (σ[#1 = #3] ((AuditB_aux × Trusted))));
      ElevatedB := (π[0,3] (σ[(#1 = #2 ∧ #3 = #4)] ((AccessB_aux × (Grant × Scope)))) ∪ π[0,5] (σ[((#0 = #2 ∧ #1 = #4) ∧ #3 = #6)] ((AccessB_aux × (AccessB_aux × Proof)))));
      AuditB := π[0,3,6] (σ[((#1 = #2 ∧ #0 = #4) ∧ #3 = #5)] ((ElevatedB_aux × (Override × Proof))));
      WHILE (¬(((AccessB = AccessB_aux) ∧ ((ElevatedB = ElevatedB_aux) ∧ (AuditB = AuditB_aux))))) DO
        AccessB_aux := AccessB;
        ElevatedB_aux := ElevatedB;
        AuditB_aux := AuditB;
        AccessB := (AccessB ∪ (π[0,1] (σ[(#0 = #2 ∧ #1 = #3)] ((Request × Permit))) ∪ π[0,1] (σ[#1 = #3] ((AuditB_aux × Trusted)))));
        ElevatedB := (ElevatedB ∪ (π[0,3] (σ[(#1 = #2 ∧ #3 = #4)] ((AccessB_aux × (Grant × Scope)))) ∪ π[0,5] (σ[((#0 = #2 ∧ #1 = #4) ∧ #3 = #6)] ((AccessB_aux × (AccessB_aux × Proof))))));
        AuditB := (AuditB ∪ π[0,3,6] (σ[((#1 = #2 ∧ #0 = #4) ∧ #3 = #5)] ((ElevatedB_aux × (Override × Proof)))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (AccessA ⊆ AccessB)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example3014
end Benchmark
end Whiel
