-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Lineage triples contained in a closed ternary cover.

  Kind: containment (goal C1_subset_C2); C1 output Lin, C2 output Prov.

  Data provenance: C1 derives lineage triples (item, derived-item, source) by propagating along reachability and generation edges, while C2 reads a ternary cover the constraints force closed under the same propagation, so every lineage triple is covered.

  A two-program containment under tuple-generating dependencies,
  generated by Claude Opus in the legacy raw_new pipeline (retired
  corpus case Example1093); the dependencies are the precondition,
  translated to relational algebra by the certified translation of the
  retired corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. ∀z1. Fact(x1, y1, z1) → Cover(x1, y1, z1)
    ∀x1. ∀y1. ∀z1. ∀x2. (Cover(x1, y1, z1) ∧ Edge(y1, x2)) → Cover(x1, x2, z1)
    ∀x1. ∀y1. ∀z1. ∀x2. (Cover(x1, y1, z1) ∧ Gen(x1, x2)) → Cover(x2, y1, z1)
    ∀x1. ∀y1. ∀z1. ∀y2. ∀z2. (Cover(x1, y1, z1) ∧ Cover(y1, y2, z2)) → Cover(x1, y2, z1)
    ∀x1. ∀y1. Edge(x1, y1) → ∃z1. Fact(x1, y1, z1)

  Program C1 (output Lin):
    `Reach(x1, y1) :- Edge(x1, y1)`
    `Reach(x1, z1) :- Reach(x1, y1), Reach(y1, z1)`
    `Reach(x1, y1) :- Lin(x1, y1, z1)`
    `Lin(x1, y1, z1) :- Fact(x1, y1, z1)`
    `Lin(x1, z1, z2) :- Lin(x1, y1, z2), Reach(y1, z1)`
    `Lin(x2, y1, z1) :- Lin(x1, y1, z1), Gen(x1, x2)`

  Program C2 (output Prov):
    `Prov(x1, y1, z1) :- Cover(x1, y1, z1)`
    `Trav(x1, y1) :- Edge(x1, y1)`
    `Trav(x1, z1) :- Trav(x1, y1), Trav(y1, z1)`
    `Prov(x1, z1, z2) :- Prov(x1, y1, z2), Trav(y1, z1)`
    `Prov(x2, y1, z1) :- Prov(x1, y1, z1), Gen(x1, x2)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(Lin ⊆ Prov)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1093

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Edge, Gen, Reach, Trav, Reach_aux, Trav_aux} (arity: 2),
    {Fact, Cover, Lin, Prov, Lin_aux, Prov_aux} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Fact ⊆ Cover) ∧ ((π[0,2,4] (σ[#1 = #3] ((Cover × Edge))) ⊆ π[0,2,1] (Cover)) ∧ ((π[1,2,4] (σ[#0 = #3] ((Cover × Gen))) ⊆ π[1,2,0] (Cover)) ∧ ((π[0,2,4] (σ[#1 = #3] ((Cover × Cover))) ⊆ π[0,2,1] (Cover)) ∧ (Edge ⊆ π[0,1] (Fact))))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      Reach_aux := ∅[2];
      Lin_aux := ∅[3];
      Reach := (Edge ∪ (π[0,3] (σ[#1 = #2] ((Reach_aux × Reach_aux))) ∪ π[0,1] (Lin_aux)));
      Lin := (Fact ∪ (π[0,4,2] (σ[#1 = #3] ((Lin_aux × Reach_aux))) ∪ π[4,1,2] (σ[#0 = #3] ((Lin_aux × Gen)))));
      WHILE (¬(((Reach = Reach_aux) ∧ (Lin = Lin_aux)))) DO
        Reach_aux := Reach;
        Lin_aux := Lin;
        Reach := (Reach ∪ (Edge ∪ (π[0,3] (σ[#1 = #2] ((Reach_aux × Reach_aux))) ∪ π[0,1] (Lin_aux))));
        Lin := (Lin ∪ (Fact ∪ (π[0,4,2] (σ[#1 = #3] ((Lin_aux × Reach_aux))) ∪ π[4,1,2] (σ[#0 = #3] ((Lin_aux × Gen))))))
      END;
      Prov_aux := ∅[3];
      Trav_aux := ∅[2];
      Prov := (Cover ∪ (π[0,4,2] (σ[#1 = #3] ((Prov_aux × Trav_aux))) ∪ π[4,1,2] (σ[#0 = #3] ((Prov_aux × Gen)))));
      Trav := (Edge ∪ π[0,3] (σ[#1 = #2] ((Trav_aux × Trav_aux))));
      WHILE (¬(((Prov = Prov_aux) ∧ (Trav = Trav_aux)))) DO
        Prov_aux := Prov;
        Trav_aux := Trav;
        Prov := (Prov ∪ (Cover ∪ (π[0,4,2] (σ[#1 = #3] ((Prov_aux × Trav_aux))) ∪ π[4,1,2] (σ[#0 = #3] ((Prov_aux × Gen))))));
        Trav := (Trav ∪ (Edge ∪ π[0,3] (σ[#1 = #2] ((Trav_aux × Trav_aux)))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (Lin ⊆ Prov)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1093
end Benchmark
end Whiel
