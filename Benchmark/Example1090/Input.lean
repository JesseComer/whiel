-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Equivalent taint reachability with ternary modes and projected frontiers.

  Kind: equivalence (goal C1_equals_C2); C1 output TaintReach, C2 output AnalysisReach.

  Models interprocedural taint propagation using a ternary mode-carrying state in one program and a binary projected frontier in the other. Mode existence and witness-backed flow dependencies make the projection abstraction exact.

  A two-program equivalence under tuple-generating dependencies,
  generated by GPT-5.6 in the legacy raw_new pipeline (retired corpus
  case Example1090); the dependencies are the precondition, translated
  to relational algebra by the certified translation of the retired
  corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. SeedPair(x1, y1) → InputPair(x1, y1)
    ∀x1. ∀y1. InputPair(x1, y1) → SeedPair(x1, y1)
    ∀x1. ∀y1. FlowEdge(x1, y1) → ViewEdge(x1, y1)
    ∀x1. ∀y1. ViewEdge(x1, y1) → FlowEdge(x1, y1)
    ∀x1. ∀y1. SeedPair(x1, y1) → ∃z1. ModeTag(y1, z1)
    ∀x1. ∀y1. FlowEdge(x1, y1) → ∃z1. ModeTag(y1, z1)
    ∀x1. ∀y1. FlowEdge(x1, y1) → ∃z1. (StateWitness(x1, y1, z1) ∧ EnabledMode(z1))
    ∀x1. ∀y1. ∀z1. (StateWitness(x1, y1, z1) ∧ EnabledMode(z1)) → FlowEdge(x1, y1)

  Program C1 (output TaintReach):
    `TaintReach(x1, y1) :- SeedPair(x1, y1)`
    `TaintState(x1, y1, z1) :- SeedPair(x1, y1), ModeTag(y1, z1)`
    `TaintReach(x1, z1) :- TaintState(x1, y1, x2), FlowEdge(y1, z1)`
    `TaintState(x1, z1, x2) :- TaintReach(x1, y1), FlowEdge(y1, z1), ModeTag(z1, x2)`
    `TaintState(x1, z1, y2) :- TaintState(x1, y1, x2), FlowEdge(y1, z1), ModeTag(z1, y2)`
    `TaintReach(x1, z1) :- TaintReach(x1, y1), TaintReach(y1, z1)`

  Program C2 (output AnalysisReach):
    `AnalysisReach(x1, y1) :- InputPair(x1, y1)`
    `FrontierState(x1, y1) :- InputPair(x1, y1)`
    `AnalysisReach(x1, z1) :- FrontierState(x1, y1), ViewEdge(y1, z1)`
    `FrontierState(x1, z1) :- AnalysisReach(x1, y1), ViewEdge(y1, z1)`
    `FrontierState(x1, z1) :- FrontierState(x1, y1), StateWitness(y1, z1, x2), EnabledMode(x2)`
    `AnalysisReach(x1, z1) :- AnalysisReach(x1, y1), AnalysisReach(y1, z1)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(TaintReach =
  AnalysisReach)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1090

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {EnabledMode} (arity: 1),
    {SeedPair, InputPair, FlowEdge, ViewEdge, ModeTag, TaintReach, AnalysisReach, FrontierState, TaintReach_aux, AnalysisReach_aux, FrontierState_aux} (arity: 2),
    {StateWitness, TaintState, TaintState_aux} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((SeedPair ⊆ InputPair) ∧ ((InputPair ⊆ SeedPair) ∧ ((FlowEdge ⊆ ViewEdge) ∧ ((ViewEdge ⊆ FlowEdge) ∧ ((π[1] (SeedPair) ⊆ π[0] (ModeTag)) ∧ ((π[1] (FlowEdge) ⊆ π[0] (ModeTag)) ∧ ((FlowEdge ⊆ π[0,1] (σ[#2 = #3] ((StateWitness × EnabledMode)))) ∧ (π[0,1] (σ[#2 = #3] ((StateWitness × EnabledMode))) ⊆ FlowEdge))))))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      TaintReach_aux := ∅[2];
      TaintState_aux := ∅[3];
      TaintReach := (SeedPair ∪ (π[0,4] (σ[#1 = #3] ((TaintState_aux × FlowEdge))) ∪ π[0,3] (σ[#1 = #2] ((TaintReach_aux × TaintReach_aux)))));
      TaintState := (π[0,1,3] (σ[#1 = #2] ((SeedPair × ModeTag))) ∪ (π[0,3,5] (σ[(#1 = #2 ∧ #3 = #4)] ((TaintReach_aux × (FlowEdge × ModeTag)))) ∪ π[0,4,6] (σ[(#1 = #3 ∧ #4 = #5)] ((TaintState_aux × (FlowEdge × ModeTag))))));
      WHILE (¬(((TaintReach = TaintReach_aux) ∧ (TaintState = TaintState_aux)))) DO
        TaintReach_aux := TaintReach;
        TaintState_aux := TaintState;
        TaintReach := (TaintReach ∪ (SeedPair ∪ (π[0,4] (σ[#1 = #3] ((TaintState_aux × FlowEdge))) ∪ π[0,3] (σ[#1 = #2] ((TaintReach_aux × TaintReach_aux))))));
        TaintState := (TaintState ∪ (π[0,1,3] (σ[#1 = #2] ((SeedPair × ModeTag))) ∪ (π[0,3,5] (σ[(#1 = #2 ∧ #3 = #4)] ((TaintReach_aux × (FlowEdge × ModeTag)))) ∪ π[0,4,6] (σ[(#1 = #3 ∧ #4 = #5)] ((TaintState_aux × (FlowEdge × ModeTag)))))))
      END;
      AnalysisReach_aux := ∅[2];
      FrontierState_aux := ∅[2];
      AnalysisReach := (InputPair ∪ (π[0,3] (σ[#1 = #2] ((FrontierState_aux × ViewEdge))) ∪ π[0,3] (σ[#1 = #2] ((AnalysisReach_aux × AnalysisReach_aux)))));
      FrontierState := (InputPair ∪ (π[0,3] (σ[#1 = #2] ((AnalysisReach_aux × ViewEdge))) ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((FrontierState_aux × (StateWitness × EnabledMode))))));
      WHILE (¬(((AnalysisReach = AnalysisReach_aux) ∧ (FrontierState = FrontierState_aux)))) DO
        AnalysisReach_aux := AnalysisReach;
        FrontierState_aux := FrontierState;
        AnalysisReach := (AnalysisReach ∪ (InputPair ∪ (π[0,3] (σ[#1 = #2] ((FrontierState_aux × ViewEdge))) ∪ π[0,3] (σ[#1 = #2] ((AnalysisReach_aux × AnalysisReach_aux))))));
        FrontierState := (FrontierState ∪ (InputPair ∪ (π[0,3] (σ[#1 = #2] ((AnalysisReach_aux × ViewEdge))) ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((FrontierState_aux × (StateWitness × EnabledMode)))))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (TaintReach = AnalysisReach)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1090
end Benchmark
end Whiel
