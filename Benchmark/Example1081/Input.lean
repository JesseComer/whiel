-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Audited delegation contained in broad authorization closure.

  Kind: containment (goal C1_subset_C2); C1 output Grant, C2 output Permit.

  Models an authorization engine where trusted, specialized, and evidence-backed delegation chains are included in a broader permission closure. The existential evidence dependency connects composite approvals to admissible broad authorization facts.

  A two-program containment under tuple-generating dependencies,
  generated by GPT-5.6 in the legacy raw_new pipeline (retired corpus
  case Example1081); the dependencies are the precondition, translated
  to relational algebra by the certified translation of the retired
  corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. Trusted(x1, y1) → Broad(x1, y1)
    ∀x1. ∀y1. Special(x1, y1) → Broad(x1, y1)
    ∀x1. ∀y1. Composite(x1, y1) → ∃z1. (Evidence(x1, y1, z1) ∧ Valid(z1))
    ∀x1. ∀y1. ∀z1. (Evidence(x1, y1, z1) ∧ Valid(z1)) → Broad(x1, y1)

  Program C1 (output Grant):
    `Grant(x1, y1) :- Trusted(x1, y1)`
    `Delegated(x1, y1) :- Special(x1, y1)`
    `Audited(x1, y1) :- Composite(x1, y1)`
    `Grant(x1, z1) :- Delegated(x1, y1), Audited(y1, z1)`
    `Delegated(x1, z1) :- Grant(x1, y1), Trusted(y1, z1)`
    `Audited(x1, z1) :- Grant(x1, y1), Evidence(y1, z1, x2), Valid(x2)`
    `Grant(x1, z1) :- Grant(x1, y1), Audited(y1, z1)`

  Program C2 (output Permit):
    `Permit(x1, y1) :- Broad(x1, y1)`
    `Trace(x1, y1) :- Broad(x1, y1)`
    `Permit(x1, y1) :- Evidence(x1, y1, z1), Valid(z1)`
    `Permit(x1, y1) :- Trace(x1, y1)`
    `Trace(x1, z1) :- Permit(x1, y1), Permit(y1, z1)`
    `Trace(x1, z1) :- Permit(x1, y1), Trace(y1, z1)`
    `Trace(x1, z1) :- Trace(x1, y1), Permit(y1, z1)`
    `Trace(x1, z1) :- Trace(x1, y1), Trace(y1, z1)`
    `Trace(x1, z1) :- Permit(x1, y1), Evidence(y1, z1, x2), Valid(x2)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(Grant ⊆ Permit)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1081

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {Valid} (arity: 1),
    {Trusted, Special, Composite, Broad, Grant, Delegated, Audited, Permit, Trace, Grant_aux, Delegated_aux, Audited_aux, Permit_aux, Trace_aux} (arity: 2),
    {Evidence} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((Trusted ⊆ Broad) ∧ ((Special ⊆ Broad) ∧ ((Composite ⊆ π[0,1] (σ[#2 = #3] ((Evidence × Valid)))) ∧ (π[0,1] (σ[#2 = #3] ((Evidence × Valid))) ⊆ Broad))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      Grant_aux := ∅[2];
      Delegated_aux := ∅[2];
      Audited_aux := ∅[2];
      Grant := (Trusted ∪ (π[0,3] (σ[#1 = #2] ((Delegated_aux × Audited_aux))) ∪ π[0,3] (σ[#1 = #2] ((Grant_aux × Audited_aux)))));
      Delegated := (Special ∪ π[0,3] (σ[#1 = #2] ((Grant_aux × Trusted))));
      Audited := (Composite ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((Grant_aux × (Evidence × Valid)))));
      WHILE (¬(((Grant = Grant_aux) ∧ ((Delegated = Delegated_aux) ∧ (Audited = Audited_aux))))) DO
        Grant_aux := Grant;
        Delegated_aux := Delegated;
        Audited_aux := Audited;
        Grant := (Grant ∪ (Trusted ∪ (π[0,3] (σ[#1 = #2] ((Delegated_aux × Audited_aux))) ∪ π[0,3] (σ[#1 = #2] ((Grant_aux × Audited_aux))))));
        Delegated := (Delegated ∪ (Special ∪ π[0,3] (σ[#1 = #2] ((Grant_aux × Trusted)))));
        Audited := (Audited ∪ (Composite ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((Grant_aux × (Evidence × Valid))))))
      END;
      Permit_aux := ∅[2];
      Trace_aux := ∅[2];
      Permit := (Broad ∪ (π[0,1] (σ[#2 = #3] ((Evidence × Valid))) ∪ Trace_aux));
      Trace := (Broad ∪ (π[0,3] (σ[#1 = #2] ((Permit_aux × Permit_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Permit_aux × Trace_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Trace_aux × Permit_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Trace_aux × Trace_aux))) ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((Permit_aux × (Evidence × Valid)))))))));
      WHILE (¬(((Permit = Permit_aux) ∧ (Trace = Trace_aux)))) DO
        Permit_aux := Permit;
        Trace_aux := Trace;
        Permit := (Permit ∪ (Broad ∪ (π[0,1] (σ[#2 = #3] ((Evidence × Valid))) ∪ Trace_aux)));
        Trace := (Trace ∪ (Broad ∪ (π[0,3] (σ[#1 = #2] ((Permit_aux × Permit_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Permit_aux × Trace_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Trace_aux × Permit_aux))) ∪ (π[0,3] (σ[#1 = #2] ((Trace_aux × Trace_aux))) ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((Permit_aux × (Evidence × Valid))))))))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (Grant ⊆ Permit)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1081
end Benchmark
end Whiel
