-- Benchmark contributors: Leo Zhang
import Whiel.Concrete.Notation
import Whiel.Hoare.PreprocDisplay
import Whiel.Hoare.ProphecySchema

/-
  Equivalent forward dependency closure and transposed reverse resolution.

  Kind: equivalence (goal C1_equals_C2); C1 output ForwardReach, C2 output ResolvedPair.

  Models distributed dependency resolution using a forward step relation in one analysis and a transposed reverse step relation in the other. Inverse seed views and bridge witnesses establish equivalence despite the opposite auxiliary orientation.

  A two-program equivalence under tuple-generating dependencies,
  generated by GPT-5.6 in the legacy raw_new pipeline (retired corpus
  case Example1088); the dependencies are the precondition, translated
  to relational algebra by the certified translation of the retired
  corpus DatalogSource.lean (RelCalc.TGD.listToAssertExpr). The
  dependencies, in the legacy relational-calculus notation:
    ∀x1. ∀y1. ForwardSeed(x1, y1) → BackwardSeed(y1, x1)
    ∀x1. ∀y1. BackwardSeed(x1, y1) → ForwardSeed(y1, x1)
    ∀x1. ∀y1. ForwardEdge(x1, y1) → ∃z1. (BridgeProof(x1, y1, z1) ∧ ValidBridge(z1))
    ∀x1. ∀y1. ∀z1. (BridgeProof(x1, y1, z1) ∧ ValidBridge(z1)) → ForwardEdge(x1, y1)
    ∀x1. ∀y1. ∀z1. (BridgeProof(x1, y1, z1) ∧ ValidBridge(z1)) → BackwardEdge(y1, x1)
    ∀x1. ∀y1. BackwardEdge(x1, y1) → ∃z1. (BridgeProof(y1, x1, z1) ∧ ValidBridge(z1))

  Program C1 (output ForwardReach):
    `ForwardReach(x1, y1) :- ForwardSeed(x1, y1)`
    `ForwardStep(x1, y1) :- ForwardEdge(x1, y1)`
    `ForwardReach(x1, z1) :- ForwardReach(x1, y1), ForwardStep(y1, z1)`
    `ForwardStep(x1, z1) :- ForwardReach(x1, y1), BridgeProof(y1, z1, x2), ValidBridge(x2)`
    `ForwardReach(x1, z1) :- ForwardStep(x1, y1), ForwardReach(y1, z1)`

  Program C2 (output ResolvedPair):
    `ResolvedPair(x1, y1) :- BackwardSeed(y1, x1)`
    `ReverseStep(y1, x1) :- BackwardEdge(y1, x1)`
    `ResolvedPair(x1, z1) :- ResolvedPair(x1, y1), ReverseStep(z1, y1)`
    `ReverseStep(z1, x1) :- ResolvedPair(x1, y1), BridgeProof(y1, z1, x2), ValidBridge(x2)`
    `ResolvedPair(x1, z1) :- ReverseStep(y1, x1), ResolvedPair(y1, z1)`

  The command is the two programs compiled by the naive compiler and run
  one after the other (snapshots `X_aux`); the legacy encoding ran them
  as one concurrent-product loop, whose steps are the same, so the
  outputs are the same least fixpoints (product_outputs_are_LFPs in the
  retired corpus DatalogSource.lean; checked on instances here).
  Precondition: the dependencies; postcondition `(ForwardReach =
  ResolvedPair)`.

  Expected verdict: valid (certified with a quantifier-free invariant in
  the earlier single-level pipeline over the product loop).

  Expected obstruction: none (anchored). Both sides are naive closures
  advancing one round per iteration, so the legacy invariant carries
  over to the merged loop of the sequence.

  Why a database audience cares: query containment and equivalence
  under dependencies is the classical setting of the chase; here the
  dependencies include existential ones (a witness must exist), and the
  claim holds, or fails, only because of them.
-/

namespace Whiel
namespace Benchmark
namespace Example1088

open Concrete

def inputSchema : UnnamedSchema ProgramNames :=
  programSch![
    {ValidBridge} (arity: 1),
    {ForwardSeed, BackwardSeed, ForwardEdge, BackwardEdge, ForwardReach, ForwardStep, ResolvedPair, ReverseStep, ForwardReach_aux, ForwardStep_aux, ResolvedPair_aux, ReverseStep_aux} (arity: 2),
    {BridgeProof} (arity: 3)
  ]

def inputPre : AssertExpr Data inputSchema :=
  programAssert![
    ((ForwardSeed ⊆ π[1,0] (BackwardSeed)) ∧ ((BackwardSeed ⊆ π[1,0] (ForwardSeed)) ∧ ((ForwardEdge ⊆ π[0,1] (σ[#2 = #3] ((BridgeProof × ValidBridge)))) ∧ ((π[0,1] (σ[#2 = #3] ((BridgeProof × ValidBridge))) ⊆ ForwardEdge) ∧ ((π[0,1] (σ[#2 = #3] ((BridgeProof × ValidBridge))) ⊆ π[1,0] (BackwardEdge)) ∧ (BackwardEdge ⊆ π[1,0] (σ[#2 = #3] ((BridgeProof × ValidBridge)))))))))
  ]

def inputCmd : Cmd Data inputSchema :=
  programCmd![
    { ExecSchema: inputSchema }
    {
      ForwardReach_aux := ∅[2];
      ForwardStep_aux := ∅[2];
      ForwardReach := (ForwardSeed ∪ (π[0,3] (σ[#1 = #2] ((ForwardReach_aux × ForwardStep_aux))) ∪ π[0,3] (σ[#1 = #2] ((ForwardStep_aux × ForwardReach_aux)))));
      ForwardStep := (ForwardEdge ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((ForwardReach_aux × (BridgeProof × ValidBridge)))));
      WHILE (¬(((ForwardReach = ForwardReach_aux) ∧ (ForwardStep = ForwardStep_aux)))) DO
        ForwardReach_aux := ForwardReach;
        ForwardStep_aux := ForwardStep;
        ForwardReach := (ForwardReach ∪ (ForwardSeed ∪ (π[0,3] (σ[#1 = #2] ((ForwardReach_aux × ForwardStep_aux))) ∪ π[0,3] (σ[#1 = #2] ((ForwardStep_aux × ForwardReach_aux))))));
        ForwardStep := (ForwardStep ∪ (ForwardEdge ∪ π[0,3] (σ[(#1 = #2 ∧ #4 = #5)] ((ForwardReach_aux × (BridgeProof × ValidBridge))))))
      END;
      ResolvedPair_aux := ∅[2];
      ReverseStep_aux := ∅[2];
      ResolvedPair := (π[1,0] (BackwardSeed) ∪ (π[0,2] (σ[#1 = #3] ((ResolvedPair_aux × ReverseStep_aux))) ∪ π[1,3] (σ[#0 = #2] ((ReverseStep_aux × ResolvedPair_aux)))));
      ReverseStep := (BackwardEdge ∪ π[3,0] (σ[(#1 = #2 ∧ #4 = #5)] ((ResolvedPair_aux × (BridgeProof × ValidBridge)))));
      WHILE (¬(((ResolvedPair = ResolvedPair_aux) ∧ (ReverseStep = ReverseStep_aux)))) DO
        ResolvedPair_aux := ResolvedPair;
        ReverseStep_aux := ReverseStep;
        ResolvedPair := (ResolvedPair ∪ (π[1,0] (BackwardSeed) ∪ (π[0,2] (σ[#1 = #3] ((ResolvedPair_aux × ReverseStep_aux))) ∪ π[1,3] (σ[#0 = #2] ((ReverseStep_aux × ResolvedPair_aux))))));
        ReverseStep := (ReverseStep ∪ (BackwardEdge ∪ π[3,0] (σ[(#1 = #2 ∧ #4 = #5)] ((ResolvedPair_aux × (BridgeProof × ValidBridge))))))
      END
    }
  ]

def inputPost : AssertExpr Data inputSchema :=
  programAssert![
    (ForwardReach = ResolvedPair)
  ]

def inputPreproc : Hoare.Preproc inputPre inputCmd inputPost :=
  Hoare.preprocess inputPre inputCmd inputPost

/- The stated triple and the loop preprocessing built. -/
set_option linter.hashCommand false in
#eval inputPreproc.display

end Example1088
end Benchmark
end Whiel
